{
  "description": "eonix-mem worker: single door to the Eonix server (episodes, notes, norms), background distill + consolidation agents, SessionStart context",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/worker/dist/eonix-mem.mjs\" hook SessionStart",
            "timeout": 25
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/worker/dist/eonix-mem.mjs\" hook UserPromptSubmit",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/worker/dist/eonix-mem.mjs\" hook PostToolUse",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/worker/dist/eonix-mem.mjs\" hook PostToolUseFailure",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/worker/dist/eonix-mem.mjs\" hook Stop",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
