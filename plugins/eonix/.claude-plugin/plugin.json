{
  "name": "eonix-mcp",
  "description": "Eonix MCP memory + official knowledge for Claude Code. Registers the marketplace MCP as an OAuth/ADFS connector and wires the auto-injection hooks (notes, official knowledge, episodic capture).",
  "version": "0.2.0",
  "author": {
    "name": "Eonix"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_session_start",
            "timeout": 6,
            "input": {
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_knowledge_check",
            "timeout": 6,
            "input": {
              "prompt": "${prompt}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_notes_check",
            "timeout": 6,
            "input": {
              "prompt": "${prompt}",
              "cwd": "${cwd}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_capture",
            "timeout": 6,
            "input": {
              "hookEventName": "UserPromptSubmit",
              "sessionId": "${session_id}",
              "cwd": "${cwd}",
              "prompt": "${prompt}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_capture",
            "timeout": 6,
            "input": {
              "hookEventName": "PostToolUse",
              "sessionId": "${session_id}",
              "cwd": "${cwd}",
              "toolName": "${tool_name}",
              "toolInputFilePath": "${tool_input.file_path}",
              "toolInputCommand": "${tool_input.command}",
              "toolResponseSuccess": "${tool_output.success}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_capture",
            "timeout": 6,
            "input": {
              "hookEventName": "Stop",
              "sessionId": "${session_id}",
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ]
  }
}
