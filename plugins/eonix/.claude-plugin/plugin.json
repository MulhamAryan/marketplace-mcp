{
  "name": "eonix-mcp",
  "description": "Eonix MCP memory + official knowledge for Claude Code. Registers the marketplace MCP as an OAuth/ADFS connector and wires the auto-injection hooks (notes, official knowledge, episodic capture).",
  "version": "0.1.0",
  "author": {
    "name": "Eonix"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://mcp.marketplace.eonix.be/api/hook/session-start",
            "timeout": 6,
            "headers": {
              "Authorization": "Bearer ${EONIX_HOOK_TOKEN}"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://mcp.marketplace.eonix.be/api/hook/knowledge-check",
            "timeout": 6,
            "headers": {
              "Authorization": "Bearer ${EONIX_HOOK_TOKEN}"
            }
          },
          {
            "type": "http",
            "url": "https://mcp.marketplace.eonix.be/api/hook/notes-check",
            "timeout": 6,
            "headers": {
              "Authorization": "Bearer ${EONIX_HOOK_TOKEN}"
            }
          },
          {
            "type": "http",
            "url": "https://mcp.marketplace.eonix.be/api/hook/capture",
            "timeout": 6,
            "headers": {
              "Authorization": "Bearer ${EONIX_HOOK_TOKEN}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "http",
            "url": "https://mcp.marketplace.eonix.be/api/hook/capture",
            "timeout": 6,
            "headers": {
              "Authorization": "Bearer ${EONIX_HOOK_TOKEN}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://mcp.marketplace.eonix.be/api/hook/capture",
            "timeout": 6,
            "headers": {
              "Authorization": "Bearer ${EONIX_HOOK_TOKEN}"
            }
          }
        ]
      }
    ]
  }
}
