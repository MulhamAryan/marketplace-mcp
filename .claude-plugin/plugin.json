{
  "name": "eonix-mcp",
  "description": "Eonix MCP memory + official knowledge for Claude Code. Registers the marketplace MCP as an OAuth/ADFS connector, wires the auto-injection hooks (notes, official knowledge) and runs the local eonix-mem worker (capture, compression, context injection; hooks in hooks/hooks.json).",
  "version": "0.7.0",
  "author": {
    "name": "Eonix"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_knowledge_check",
            "timeout": 6,
            "input": {
              "prompt": "${prompt}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_notes_check",
            "timeout": 6,
            "input": {
              "prompt": "${prompt}",
              "cwd": "${cwd}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_consolidation_check",
            "timeout": 6,
            "input": {
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:eonix-mcp:marketplace",
            "tool": "hook_distill_reminder",
            "timeout": 6,
            "input": {}
          }
        ]
      }
    ]
  }
}
